# Copy to `.env.production` (git-ignored) and replace every placeholder before deploying.
# Used by docker-compose.prod.yml. Development settings live in .env.example.

# Database. Use a long random password. Avoid characters that need URL-encoding (@ : / ? #).
POSTGRES_USER=inkroom
POSTGRES_PASSWORD=replace-with-a-long-random-value
POSTGRES_DB=inkroom

# The public origin users open in the browser. Must be https. Session cookies are Secure.
WEB_ORIGIN=https://inkroom.example.com

# Loopback port the web container publishes; the TLS proxy forwards to it.
WEB_PORT=21173

# Log level for the API: fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info

# Image tag for the API and web images. Use a release tag to make rollbacks explicit.
INKROOM_TAG=local
