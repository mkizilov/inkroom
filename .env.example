# Copy to `.env` (git-ignored) and adjust for your machine. Defaults use loopback ports
# in the 21000-21099 range.

# API (apps/api)
API_HOST=127.0.0.1
API_PORT=21080
DATABASE_URL=postgres://inkroom:inkroom@127.0.0.1:21432/inkroom
# Origin of the web app. Cookie-authenticated API writes must come from this origin.
WEB_ORIGIN=http://127.0.0.1:21173
# Leave empty to use Secure cookies in production only. Set to true or false to override.
# Production refuses COOKIE_SECURE=false.
# COOKIE_SECURE=false
# Log level: fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info
# Reverse proxies whose X-Forwarded-For is trusted (comma-separated addresses or CIDR ranges).
# Leave empty unless a proxy sits in front of the API.
# TRUST_PROXY=127.0.0.1
# Integration tests create and drop their own schemas in this database.
TEST_DATABASE_URL=postgres://inkroom:inkroom@127.0.0.1:21432/inkroom

# Local PostgreSQL (docker-compose.yml)
POSTGRES_USER=inkroom
POSTGRES_PASSWORD=inkroom
POSTGRES_DB=inkroom
POSTGRES_PORT=21432
