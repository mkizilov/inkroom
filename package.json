{
  "name": "inkroom",
  "version": "0.1.0",
  "private": true,
  "description": "InkRoom: a collaborative whiteboard application",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.9.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @inkroom/api --filter @inkroom/web run dev",
    "build": "pnpm -r run build",
    "start": "pnpm --filter @inkroom/api run start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @inkroom/api run db:generate",
    "db:migrate": "pnpm --filter @inkroom/api run db:migrate",
    "db:seed": "pnpm --filter @inkroom/api run db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
